

<div class="container py-5">
    <div class="row">
        <aside class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm p-3 rounded-4">
                <h5 class="fw-bold mb-3 filter-title text-uppercase">Filtros</h5>

                <form method="get" asp-controller="Productos" asp-action="Index">


                    <div class="mb-4">
                        <label class="form-label small fw-bold">Buscar</label>
                        <input type="text" name="search" class="form-control" placeholder="¿Qué buscas?">
                        <br />
                        <button type="submit" class="btn btn-dark w-100 rounded-pill" style="background-color: var(--primary-dark);">
                            Aplicar Filtros
                        </button>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Categorías</label>
                        <select name="idCategoria" class="form-select">
                            <option value="">Todas</option>
                            @foreach (var cat in ViewBag.Categorias)
                            {
                                <option value="@cat.IdCategoria">@cat.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Marcas</label>
                        @foreach (var marca in ViewBag.Marcas)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="marcas" value="@marca.IdMarca" id="m-@marca.IdMarca">
                                <label class="form-check-label small" for="m-@marca.IdMarca">@marca.Nombre</label>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </aside>

        <main class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="text-muted mb-0">Mostrando <strong>@Model.Count</strong> productos</p>
            </div>

            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="card h-100 product-card shadow-sm">
                            <div class="position-relative">
                                <img src="@item.Imagen" class="card-img-top p-3" alt="@item.Nombre" style="height: 200px; object-fit: contain;">
                                <span class="badge position-absolute top-0 start-0 m-3 badge-category">
                                    @item.IdCategoriaNavigation?.Nombre
                                </span>
                            </div>

                            <div class="card-body d-flex flex-column text-center">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; color: var(--accent-gold) !important;">
                                    @item.IdMarcaNavigation?.Nombre
                                </small>
                                <h6 class="card-title fw-bold my-2" style="color: var(--primary-dark);">@item.Nombre</h6>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>
</div>


<div class="container py-5">
    <div class="row">
        <main class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="text-muted mb-0">Mostrando <strong>@Model.Count</strong> productos</p>
            </div>

            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="card h-100 product-card shadow-sm">
                            <div class="position-relative">
                                <img src="@item.Imagen" class="card-img-top p-3" alt="@item.Nombre" style="height: 200px; object-fit: contain;">
                                <span class="badge position-absolute top-0 start-0 m-3 badge-category">
                                    @item.IdCategoriaNavigation?.Nombre
                                </span>
                            </div>

                            <div class="card-body d-flex flex-column text-center">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem; color: var(--accent-gold) !important;">
                                    @item.IdMarcaNavigation?.Nombre
                                </small>
                                <h6 class="card-title fw-bold my-2" style="color: var(--primary-dark);">@item.Nombre</h6>

                            </div>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>
</div>
@{
    ViewData["Title"] = "Distribuidora Cali | Centro de Distribución Luján y Zonas de Entrega";
    ViewData["Description"] = "Distribuidora mayorista con centro en Luján. Abastecemos comercios en Mercedes, Chivilcoy, Cañuelas, General Rodríguez y más de 15 localidades.";

}

@model List<Marca>

<div class="logo-animation-container">
    <img src="~/images/erco/logo.svg" alt="Símbolo ERCO" class="logo-symbol">

    <div class="logo-text-container">
        <img src="~/images/erco/nombre.svg" alt="ERCO" class="logo-text">
    </div>
</div>


<div id="carouselErco" class="carousel slide" data-bs-ride="carousel" data-aos="zoom-in-up" data-aos-duration="1500">
    @{

        var relativePath = "images/erco/logistica";
        var absolutePath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", relativePath);

        List<string> images = new List<string>();

        if (Directory.Exists(absolutePath))
        {
            images = Directory.EnumerateFiles(absolutePath)
            .Where(f => f.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
            .Select(f => System.IO.Path.GetFileName(f))
            .ToList();
        }

        var isFirst = true;
    }

    <div id="carouselErco" class="carousel slide position-relative">

        <div class="position-absolute top-50 start-50 translate-middle w-100" style="z-index: 10;">
            <div class="container text-center">
                <h2 class="text-light text-shadow display-5 fw-bold">
                    ERCO: Distribuidora Mayorista.<br>
                    Abastecemos tu negocio con<br>
                    compromiso y calidad.
                </h2>
            </div>
        </div>

        <div class="carousel-inner">
            @if (images.Any())
            {
                @foreach (var imageName in images)
                {
                    <div class="carousel-item @(isFirst ? "active" : "")">
                        <div class="d-flex align-items-center justify-content-center carousel-gradient"
                             style="background-image: linear-gradient(to right, rgba(255, 165, 0, 0.3), rgba(255, 0, 150, 0.3)),
                                 url('@Url.Content("~/" + relativePath + "/" + imageName)'); height: 600px; background-size: cover;">
                        </div>
                    </div>
                    isFirst = false;
                }
            }
        </div>
    </div>
</div>
<section class="container" style="margin-top: -80px; position: relative; z-index: 10;">
    <div class="row justify-content-center g-4">

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
            <div class="card card-inicio border-0 shadow-lg text-center h-100">
                <a class="text-decoration-none text-reset" asp-controller="Promociones" asp-action="Index">
                    <div class="card-body p-5">
                        <div style="color: #c02873;" class="mb-3"><i class="bi bi-tags fs-1"></i></div>
                        <h4 class="fw-bold">OFERTAS</h4>
                        <p class="text-muted">Precios exclusivos y promociones semanales que no podés dejar pasar.</p>
                    </div>
                </a>
                
            </div>
        </div>

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
            <div class="card card-inicio border-0 shadow-lg text-center h-100">
                <div class="card-body p-5">
                    <div style="color: #dfa12a;" class="mb-3">
                        <i class="bi bi-clock-history fs-1"></i>
                    </div>

                    <h4 class="fw-bold text-uppercase">Horarios de Atención</h4>

                    <div class="mt-4">
                        <p class="mb-2">
                            <strong>Lunes a Viernes y Feriados</strong><br>
                            <span class="text-muted">9:00 a 14:00</span>
                        </p>
                        <p class="mb-0">
                            <strong>Sábados</strong><br>
                            <span class="text-muted">9:00 a 12:00</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
            <div class="card card-inicio border-0 shadow-lg text-center h-100" >
                <a class="text-decoration-none text-reset" asp-controller="Sucursales" asp-action="Index">
                    <div class="card-body p-5">
                        <div style="color: #ca5e40;" class="mb-3"><i class="bi bi-geo-alt fs-1"></i></div>
                        <h4 class="fw-bold">ALCANCE</h4>
                        <p class="text-muted">Distribución eficiente en toda la zona con compromiso y calidad.</p>
                    </div>
                </a>

            </div>
        </div>
    </div>
</section>
<br /><br /><br /><br />
<div id="carouselMarcas" class="carousel slide" data-bs-ride="carousel" >
    <div class="carousel-inner">
        @{
            int logosPorSlide = 4;
            int totalSlides = (int)Math.Ceiling((double)Model.Count / logosPorSlide);
        }

        @for (int i = 0; i < totalSlides; i++)
        {
            <div class="carousel-item @(i == 0 ? "active" : "")" data-bs-interval="3000">
                <div class="d-flex justify-content-around align-items-center" style="height: 200px;">
                    @foreach (var marca in Model.Skip(i * logosPorSlide).Take(logosPorSlide))
                    {
                        <div class="text-center p-3" style="width: 25%;">
                            <img src="@Url.Content(marca.Imagen)"
                                 alt="@marca.Nombre"
                                 class="img-fluid"
                                 style="max-height: 100px; width: auto; transition: 0.3s;"
                                 >
                            <p class="small mt-2 text-muted">@marca.Nombre</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselMarcas" data-bs-slide="prev" style="filter: invert(1);">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselMarcas" data-bs-slide="next" style="filter: invert(1);">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: #3e3f3f;">¿Cómo comprar en ERCO?</h2>
            <p class="text-muted">Un proceso simple pensado para la agilidad de tu negocio.</p>
        </div>

        <div class="row text-center position-relative">
            <div class="d-none d-lg-block position-absolute" style="top: 25%; left: 2%; right: 5%; height: 2px; border-top: 2px dashed #e0e0e0; z-index: 1;"></div>

            <div class="col-lg-4 mb-4 mb-lg-0 position-relative" style="z-index: 2;">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 80px; height: 80px; background-color: #c02873; border-radius: 50%; color: white;">
                    <i class="bi bi-search fs-2"></i>
                </div>
                <h5 class="fw-bold">1. Explorá</h5>
                <p class="px-3 text-muted small">Navegá nuestra amplia variedad online o hablá con un asesor preventista.</p>
            </div>

            <div class="col-lg-4 mb-4 mb-lg-0 position-relative" style="z-index: 2;">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 80px; height: 80px; background-color: #dfa12a; border-radius: 50%; color: white;">
                    <i class="bi bi-chat-dots fs-2"></i>
                </div>
                <h5 class="fw-bold">2. Coordiná</h5>
                <p class="px-3 text-muted small">Confirmá las cantidades y acordá el día de entrega para tu zona.</p>
            </div>

            <div class="col-lg-4 mb-4 mb-lg-0 position-relative" style="z-index: 2;">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 80px; height: 80px; background-color: #ca5e40; border-radius: 50%; color: white;">
                    <i class="bi bi-shop fs-2"></i>
                </div>
                <h5 class="fw-bold">3. Recibí</h5>
                <p class="px-3 text-muted small">Agilidad y seguridad con nuestra entrega directa y compromiso de calidad.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts{
    <script>
        window.addEventListener('load', () => {
          const container = document.querySelector('.logo-animation-container');

          if (!sessionStorage.getItem('introDone')) {
            container.classList.add('start-anim');
            sessionStorage.setItem('introDone', 'true');

            setTimeout(() => {
              container.classList.add('hidden');
            }, 2000);

          } else {
            container.classList.add('no-animation');
          }
        });
    </script>
    <script>
            document.addEventListener('DOMContentLoaded', function () {
                var myCarouselElement = document.querySelector('#carouselErco');

                var existingInstance = bootstrap.Carousel.getInstance(myCarouselElement);
                if (existingInstance) {
                    existingInstance.dispose();
                }

                var carousel = new bootstrap.Carousel(myCarouselElement, {
                    interval: 2500,
                    ride: 'carousel',
                    pause: 'hover',
                    wrap: true 
                });
            });
    </script>
}
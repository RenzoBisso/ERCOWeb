@{
    ViewData["Title"] = "Home Page";
}

<div data-aos="zoom-in-up" data-aos-duration="1500" class="container-fluid px-0 py-5 d-flex align-items-center justify-content-center text-center"
     style="background-image: url('@Url.Content("~/images/fondo_gradiente.jpg")'); background-size: cover; background-position: center; min-height: 400px;">
    <div>
        <h2 class="text-light text-shadow">
            ERCO: Distribuidora Mayorista.<br>
            Abastecemos tu negocio con<br>
            compromiso y calidad.
        </h2>
    </div>
</div>

<section class="container" style="margin-top: -80px; position: relative; z-index: 10;">
    <div class="row justify-content-center g-4">

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
            <div class="card card-inicio border-0 shadow-lg text-center h-100" >
                <div class="card-body p-5">
                    <div style="color: #c02873;" class="mb-3"><i class="bi bi-truck fs-1"></i></div>
                    <h4 class="fw-bold">LOGÍSTICA</h4>
                    <p class="text-muted">Flota propia para asegurar que tu pedido llegue siempre a tiempo.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
            <div class="card card-inicio border-0 shadow-lg text-center h-100">
                <a class="text-decoration-none text-reset" asp-controller="Productos" asp-action="Index">
                    <div class="card-body p-5">
                        <div style="color: #dfa12a;" class="mb-3"><i class="bi bi-box-seam fs-1"></i></div>
                        <h4 class="fw-bold">STOCK</h4>
                        <p class="text-muted">Diversidad y excelencia en cada artículo de nuestro inventario..</p>
                    </div>
                </a>

            </div>
        </div>
        
        <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
            <div class="card card-inicio border-0 shadow-lg text-center h-100" >
                <a class="text-decoration-none text-reset" asp-controller="Sucursales" asp-action="Index">
                    <div class="card-body p-5">
                        <div style="color: #ca5e40;" class="mb-3"><i class="bi bi-geo-alt fs-1"></i></div>
                        <h4 class="fw-bold">ALCANCE</h4>
                        <p class="text-muted">Distribución eficiente en toda la zona con compromiso y calidad.</p>
                    </div>
                </a>

            </div>
        </div>
    </div>
</section>
<br />
<br />
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: #3e3f3f;">¿Cómo comprar en ERCO?</h2>
            <p class="text-muted">Un proceso simple pensado para la agilidad de tu negocio.</p>
        </div>

        <div class="row text-center position-relative">
            <div class="d-none d-lg-block position-absolute" style="top: 25%; left: 5%; right: 5%; height: 2px; border-top: 2px dashed #e0e0e0; z-index: 1;"></div>

            <div class="col-lg-4 mb-4 mb-lg-0 position-relative" style="z-index: 2;">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 80px; height: 80px; background-color: #c02873; border-radius: 50%; color: white;">
                    <i class="bi bi-search fs-2"></i>
                </div>
                <h5 class="fw-bold">1. Explorá</h5>
                <p class="px-3 text-muted small">Navegá nuestra amplia variedad online o hablá con un asesor preventista.</p>
            </div>

            <div class="col-lg-4 mb-4 mb-lg-0 position-relative" style="z-index: 2;">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 80px; height: 80px; background-color: #dfa12a; border-radius: 50%; color: white;">
                    <i class="bi bi-chat-dots fs-2"></i>
                </div>
                <h5 class="fw-bold">2. Coordiná</h5>
                <p class="px-3 text-muted small">Confirmá las cantidades y acordá el día de entrega para tu zona.</p>
            </div>

            <div class="col-lg-4 mb-4 mb-lg-0 position-relative" style="z-index: 2;">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 80px; height: 80px; background-color: #ca5e40; border-radius: 50%; color: white;">
                    <i class="bi bi-shop fs-2"></i>
                </div>
                <h5 class="fw-bold">3. Recibí</h5>
                <p class="px-3 text-muted small">Agilidad y seguridad con nuestra entrega directa y compromiso de calidad.</p>
            </div>
        </div>
    </div>
</section>
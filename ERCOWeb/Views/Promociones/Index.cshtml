@model List<Promo>

<br />
<section class="container py-5">
    <div class="text-center mb-5">
        <span class="badge rounded-pill bg-dark px-3 py-2 mb-3">
            <i class="bi bi-tag-fill me-2"></i>OFERTAS DISPONIBLES
        </span>
        <h1 class="fw-bold">Nuestras <span class="text-warning">Ofertas</span></h1>
    </div>
    <div class="row justify-content-center g-4">

        @foreach (var promo in Model)
        {
            <div class="col-md-4 d-flex justify-content-center" data-aos="flip-down" data-aos-delay="150">
                <div class="card card-promo border-0 shadow-sm" style="border-radius: 15px; overflow: hidden; max-width: 20rem;">

                    <div class="position-relative" style="border-bottom: 5px solid #FDB813;">
                        <img src="@Url.Content(promo.Imagen)"
                             class="img-fluid w-100"
                             alt="Promo"
                             style="display: block; height: auto; min-height: 250px; object-fit: cover;" />
                    </div>

                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold">@promo.Titulo</h5>
                        <p class="card-text text-muted small">@promo.Descripcion</p>

                        <hr class="my-3 opacity-25">

                        <div class="mb-1 small fw-bold" style="color: #FDB813;">
                            <i class="bi bi-calendar-event me-2"></i>Inicio: @promo.FechaInicio.ToShortDateString()
                        </div>
                        <div class="mb-3 small fw-bold" style="color: #FDB813;">
                            <i class="bi bi-calendar-check me-2"></i>Fin: @promo.FechaFin.ToShortDateString()
                        </div>
                        <div class="mb-3 small fw-bold" style="color: #FDB813;">
                            <i class="bi bi-file-pdf me-2"></i> <a href="@Url.Content(promo.Pdf)" target="_blank">Ver el pdf para mas detalle</a>
                        </div>
                        <p class="text-muted mb-0" style="font-size: 0.7rem; font-style: italic;">
                            * Oferta demostrativa. Sujeta hasta agotar stock y términos.
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@using Microsoft.EntityFrameworkCore.Metadata
@model (List<Sucursal> sucursales, List<IProperty> propiedades, string keyName)

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="fw-bold h2 mb-1">Gestión de Sucursales</h1>
            <p class="text-muted small mb-0">Administra, filtra y edita las sucursales vigentes de la plataforma.</p>
        </div>
        <a asp-controller="Admin" asp-action="CargarSucursal" class="btn btn-primary btn-lg px-4 shadow-sm rounded-pill">
            <i class="bi bi-plus-lg me-2"></i>Nueva Sucursal
        </a>
    </div>
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-12">
                    <label class="form-label fw-semibold text-dark small">Buscar por nombre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Ej: Lujan">
                    </div>
                </div>
                <div class="col-lg-2 col-md-2">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark w-100 shadow-sm">
                            <i class="bi bi-funnel-fill"></i>
                        </button>
                        <a asp-action="Sucursales" class="btn btn-outline-secondary w-100 shadow-sm">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        @foreach (var propiedad in Model.propiedades)
                        {
                            <th class="py-3 px-4 text-uppercase fs-xs fw-bold text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                @propiedad.Name
                            </th>
                        }
                        <th class="py-3 px-4 text-end text-uppercase fs-xs fw-bold text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sucursal in Model.sucursales)
                    {
                        <tr>
                            @foreach (var propiedad in Model.propiedades)
                            {
                                var value = sucursal.GetType().GetProperty(propiedad.Name)?.GetValue(sucursal);
                                <td class="px-4 py-3">
                                    @if (value is bool boolValue)
                                    {
                                        <span class="badge @(boolValue ? "bg-success" : "bg-danger")">
                                            @(boolValue ? "Activo" : "Inactivo")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">@value</span>
                                    }
                                </td>
                            }

                            @{
                                var idValue = sucursal.GetType().GetProperty(Model.keyName)?.GetValue(sucursal);
                            }

                            <td class="px-4 py-3 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="ModificarSucursal" asp-route-id="@idValue" class="btn btn-light btn-sm border shadow-sm px-3 rounded-pill hover-warning">
                                        <i class="bi bi-pencil-square text-warning me-1"></i> Editar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

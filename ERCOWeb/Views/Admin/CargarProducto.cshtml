@model Producto
<style>
    footer {
        display: none !important;
    }

    #canal-wpp {
        display: none !important;
    }
</style>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4">
                    <h4 class="mb-0"><i class="bi bi-box-seam me-2"></i>Nuevo Producto</h4>
                    <p class="mb-0 small opacity-75">Ingresa los detalles del artículo para el catálogo.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Admin" asp-action="CargarProducto" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre del Producto</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Jabón Líquido 500ml" required>
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="IdCategoria" class="form-label fw-bold">Categoría</label>
                                <select asp-for="IdCategoria" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.Categorias, "IdCategoria", "Nombre"))">
                                    <option value="">-- Seleccionar --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IdMarca" class="form-label fw-bold">Marca</label>
                                <select asp-for="IdMarca" class="form-select"
                                        asp-items="@(new SelectList(ViewBag.Marcas, "IdMarca", "Nombre"))">
                                    <option value="">-- Seleccionar --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="imgProducto" class="form-label fw-bold">Imagen del Producto</label>
                            <input type="file" name="imgProducto" id="imgProducto" class="form-control" accept="image/*" required>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="estado" asp-for="Estado">
                                <label class="form-check-label fw-bold" for="estado">Producto Activo</label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a asp-action="Productos" class="btn btn-outline-secondary px-4 rounded-pill">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm">
                                Guardar Producto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@model ERCOWeb.Models.Catalogo
@{
    ViewData["Title"] = "Actualizar Catálogo " + Model.Tipo;
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex align-items-center gap-3 mb-5">
        <a asp-controller="Admin" asp-action="Catalogos" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <div>
            <h1 class="fw-bold h2 mb-1">Actualizar Catálogo @Model.Tipo</h1>
            <p class="text-muted small mb-0">
                Subí el nuevo PDF y/o la nueva imagen de portada para este mes.
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">

                    <form asp-action="ActualizarCatalogo" method="post" enctype="multipart/form-data">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdCatalogo" value="@Model.IdCatalogo" />

                        @* Descripción / mes *@
                        <div class="mb-4">
                            <label for="Descripcion" class="form-label fw-semibold">
                                Descripción <span class="text-muted fw-normal">(opcional, ej: "Mayo 2025")</span>
                            </label>
                            <input type="text" name="Descripcion" id="Descripcion"
                                   class="form-control rounded-3"
                                   value="@Model.Descripcion"
                                   placeholder="Ej: Mayo 2025" />
                        </div>

                        @* Imagen *@
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Imagen de portada
                                <span class="text-muted fw-normal">(JPG, PNG — opcional)</span>
                            </label>
                            @if (!string.IsNullOrEmpty(Model.Imagen))
                            {
                                <div class="mb-2">
                                    <img src="@Model.Imagen" alt="Portada actual"
                                         style="max-height:130px; border-radius:10px; object-fit:cover;" />
                                    <p class="text-muted small mt-1">
                                        Portada actual. Subí una nueva para reemplazarla.
                                    </p>
                                </div>
                            }
                            <input type="file" name="imagen" class="form-control rounded-3"
                                   accept="image/*" onchange="previewImg(this)" />
                            <div id="previewContainer" class="mt-2 d-none">
                                <img id="imgPreview" src="#" alt="Nueva portada"
                                     style="max-height:130px; border-radius:10px; object-fit:cover;" />
                            </div>
                        </div>

                        @* PDF *@
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Nuevo PDF</label>
                            @if (!string.IsNullOrEmpty(Model.Pdf))
                            {
                                <div class="mb-2 d-flex align-items-center gap-2 p-3 rounded-3"
                                     style="background:#f0fdf4; border:1px solid #bbf7d0;">
                                    <i class="bi bi-file-earmark-pdf text-danger fs-5"></i>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small text-success">PDF actual cargado</div>
                                    </div>
                                    <a href="@Model.Pdf" target="_blank"
                                       class="btn btn-sm btn-outline-success rounded-pill px-3">
                                        Ver
                                    </a>
                                </div>
                                <p class="text-muted small">Subí un nuevo PDF para reemplazarlo.</p>
                            }
                            else
                            {
                                <div class="alert alert-warning rounded-3 small py-2">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    No hay PDF cargado aún.
                                </div>
                            }
                            <input type="file" name="archivoPdf" class="form-control rounded-3"
                                   accept=".pdf" />
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit"
                                    class="btn btn-primary px-5 rounded-pill fw-bold">
                                <i class="bi bi-arrow-repeat me-2"></i>Actualizar
                            </button>
                            <a href="/Admin/Catalogos"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                Cancelar
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImg(input) {
        const container = document.getElementById('previewContainer');
        const img = document.getElementById('imgPreview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                img.src = e.target.result;
                container.classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        } else {
            container.classList.add('d-none');
        }
    }
</script>

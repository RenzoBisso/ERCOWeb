@model ERCOWeb.Models.Catalogo
@{
    ViewData["Title"] = "Nuevo Catálogo";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex align-items-center gap-3 mb-5">
        <a asp-controller="Admin" asp-action="Catalogos" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
        <div>
            <h1 class="fw-bold h2 mb-1">Nuevo Catálogo</h1>
            <p class="text-muted small mb-0">Completá los datos para publicar un nuevo catálogo en el sitio.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <form asp-action="CargarCatalogo" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold">Descripción <span class="text-muted fw-normal">(opcional)</span></label>
                            <textarea asp-for="Descripcion" class="form-control rounded-3" rows="3"
                                      placeholder="Breve descripción del contenido del catálogo"></textarea>
                        </div>

                        <div class="mb-4">
                            <label for="imagen" class="form-label fw-semibold">Imagen de portada <span class="text-muted fw-normal">(JPG, PNG)</span></label>
                            <input type="file" name="imagen" id="imagen" class="form-control rounded-3" accept="image/*"
                                   onchange="previewImagen(this)" />
                            <div id="previewContainer" class="mt-2 d-none">
                                <img id="imgPreview" src="#" alt="Preview"
                                     style="max-height:160px;border-radius:12px;object-fit:cover;" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="archivoPdf" class="form-label fw-semibold">Archivo PDF <span class="text-muted fw-normal">(opcional)</span></label>
                            <input type="file" name="archivoPdf" id="archivoPdf" class="form-control rounded-3" accept=".pdf" />
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-primary px-5">Cargar Catalogo</button>
                            <a asp-action="Catalogos" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImagen(input) {
            const container = document.getElementById('previewContainer');
            const img = document.getElementById('imgPreview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => { img.src = e.target.result; container.classList.remove('d-none'); };
                reader.readAsDataURL(input.files[0]);
            } else {
                container.classList.add('d-none');
            }
        }
    </script>
}

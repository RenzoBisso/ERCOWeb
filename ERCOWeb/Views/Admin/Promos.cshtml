<style>
    footer {
        display: none !important;
    }

    #canal-wpp {
        display: none !important;
    }
</style>
@using Microsoft.EntityFrameworkCore.Metadata
@model (List<Promo> promos, List<IProperty> propiedades, string keyName)

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
        <div>
            <h1 class="fw-bold h2 mb-1">Gestión de Promociones</h1>
            <p class="text-muted small mb-0">Administra, filtra y edita las ofertas vigentes de la plataforma.</p>
        </div>
        <a asp-controller="Admin" asp-action="CargarPromo" class="btn btn-primary btn-lg px-4 shadow-sm rounded-pill">
            <i class="bi bi-plus-lg me-2"></i>Nueva Promo
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-12">
                    <label class="form-label fw-semibold text-dark small">Buscar por nombre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Ej: Especial Verano...">
                    </div>
                </div>

                <div class="col-lg-3 col-md-5">
                    <label class="form-label fw-semibold text-dark small">Desde</label>
                    <input type="date" name="startDate" class="form-control">
                </div>
                <div class="col-lg-3 col-md-5">
                    <label class="form-label fw-semibold text-dark small">Hasta</label>
                    <input type="date" name="endDate" class="form-control">
                </div>

                <div class="col-lg-2 col-md-2">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark w-100 shadow-sm">
                            <i class="bi bi-funnel-fill"></i>
                        </button>
                        <a asp-action="Promos" class="btn btn-outline-secondary w-100 shadow-sm">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        @foreach (var propiedad in Model.propiedades)
                        {
                            <th class="py-3 px-4 text-uppercase fs-xs fw-bold text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                @propiedad.Name
                            </th>
                        }
                        <th class="py-3 px-4 text-end text-uppercase fs-xs fw-bold text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var promo in Model.promos)
                    {
                        <tr>
                            @foreach (var dato in Model.propiedades)
                            {
                                var value = promo.GetType().GetProperty(dato.Name)?.GetValue(promo);

                                <td class="px-4 py-3">
                                    @if (value is DateOnly dateOnlyValue)
                                    {
                                        <span class="text-dark fw-medium">@dateOnlyValue.ToString("dd MMM, yyyy")</span>
                                    }
                                    else if (value is DateTime dateTimeValue)
                                    {
                                        <span class="text-dark fw-medium">@dateTimeValue.ToString("dd MMM, yyyy")</span>
                                    }
                                    else if (dato.Name.Contains("Precio") || dato.Name.Contains("Monto"))
                                    {
                                        <span class="badge bg-success-soft text-success">@string.Format("{0:C}", value)</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">@value</span>
                                    }
                                </td>
                            }

                            @{
                                var idValue = promo.GetType().GetProperty(Model.keyName)?.GetValue(promo);
                            }

                            <td class="px-4 py-3 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="ModificarPromo" asp-route-id="@idValue" class="btn btn-light btn-sm border shadow-sm px-3 rounded-pill hover-warning">
                                        <i class="bi bi-pencil-square text-warning me-1"></i> Editar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ERCO-Distribuidora</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERCOWeb.styles.css" asp-append-version="true" />
    <link href="~/lib/aos-master/aos-master/dist/aos.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/dist/leaflet.css" rel="stylesheet" />
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WholesaleStore",
          "name": "ERCO S.R.L.",
          "alternateName": ["Distribuidora Cali", "Del Sol Distribuciones"],
          "foundingDate": "1987",
          "description": "Distribuidora mayorista líder en Luján y Provincia de Buenos Aires. Representante oficial de Unilever, Bagley, Kimberly-Clark y marcas líderes.",
          "logo": "https://tuweb.com.ar/images/logo.png",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "https://www.google.com/maps/place/Erco+S.r.l./@@-34.5714508,-59.0936119,21z/data=!4m6!3m5!1s0x95bc877a91acb36d:0x8677d54c242137ba!8m2!3d-34.5714122!4d-59.0935933!16s%2Fg%2F11j4swg6q_?entry=tts&g_ep=EgoyMDI2MDQyMC4wIPu8ASoASAFQAw%3D%3D&skid=a3a68166-bb8d-4e04-afc3-4886de5c031b",
            "addressLocality": "Luján",
            "addressRegion": "Buenos Aires",
            "addressCountry": "AR"
          },
          "areaServed": [
            "Luján",
            "San Andrés de Giles",
            "Carmen de Areco",
            "General Rodríguez",
            "Navarro",
            "Alberti",
            "Roque Perez",
            "Pedernales",
            "Riestra",
            "Marcos Paz",
            "Saladillo",
            "Del Carril",
            "Polvaredas",
            "Cañuelas",
            "Lobos",
            "Mercedes",
            "Chivilcoy",
            "Chacabuco",
            "Suipacha"
          ],
          "brand": [
            {"@@type": "Brand", "name": "Unilever"},
            {"@@type": "Brand", "name": "Bagley"},
            {"@@type": "Brand", "name": "Kimberly-Clark"},
            {"@@type": "Brand", "name": "Jorgito"},
            {"@@type": "Brand", "name": "Cepas Argentinas"}
          ]
        }
    </script>
</head>
<body>
    <a href="https://api.whatsapp.com/send/?phone=5492323301623&text=Hola%21+Te+escribo+desde+la+web%21&type=phone_number&app_absent=0" class="whatsapp-btn" target="_blank">
        <img src="~/images/logo_wpp.svg" alt="Chat con nosotros">
    </a>
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand d-lg-none"
                   href="javascript:void(0)"
                   data-bs-toggle="collapse"
                   data-bs-target="#menuPrincipal">
                    <img src="/images/erco/logo.svg" alt="Logo" width="50">
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="menuPrincipal">
                    <ul class="navbar-nav align-items-center gap-lg-4 text-center">

                        <li class="nav-item d-none d-lg-block px-3">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <img src="/images/erco/logo_erco_navbar.svg" alt="Logo ERCO" width="200" style="cursor: pointer;">
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><strong>INICIO</strong></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Nosotros" asp-action="Index"><strong>NOSOTROS</strong> </a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index"><strong>PRODUCTOS</strong></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="NuestrasMarcas" asp-action="Index"><strong>MARCAS</strong></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Sucursales" asp-action="Index"><strong>SUCURSALES</strong></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Consultas" asp-action="Index"><strong>CONSULTAS</strong></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Promociones" asp-action="Index"><strong>PROMOCIONES</strong></a></li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>
    <div class="container-fluid px-0 ">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <section id="canal-wpp" class="py-5" data-aos="fade-up" data-aos-duration="1400">
        <div class="container">
            <div class="card border-0 shadow-sm" style="border-radius: 40px; background: linear-gradient(135deg, #ffffff 0%, #fdf5e6 100%); overflow: hidden;">
                <div class="row g-0 align-items-center">

                    <div class="col-md-7 p-5">
                        <div class="d-flex align-items-center mb-4">
                            <img src="~/images/logo_erco_para_web-13.png" alt="Logo ERCO" style="height: 70px;padding-top:30px;" class="mb-4">
                            <h2 class="fw-bold m-0" style="color: #d35400; letter-spacing: -1px;">ERCO</h2>
                        </div>

                        <h2 class="display-5 fw-bold mb-3" style="color: #b34700; line-height: 1.1;">
                            Unite al canal de<br>ERCO Mayorista
                        </h2>

                        <p class="fs-5 mb-4" style="color: #444; max-width: 500px;">
                            Recibí ofertas exclusivas en <strong>alimentos, perfumería y limpieza</strong> directo en WhatsApp.
                        </p>
                    </div>

                    <div class="col-md-5 d-flex flex-column align-items-center justify-content-center p-5">
                        <div class="bg-white p-4 shadow-lg text-center" style="border-radius: 25px; max-width: 300px;">
                            <div class="mb-2">
                                <i class="bi bi-whatsapp" style="font-size: 3rem; color: #25D366;"></i>
                            </div>

                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://whatsapp.com/channel/0029Vb7bVtG23n3iPdsONz0K"
                                 alt="QR WhatsApp" class="img-fluid mb-4" style="border-radius: 10px;">

                            <a href="https://whatsapp.com/channel/0029Vb7bVtG23n3iPdsONz0K" target="_blank"
                               class="btn w-100 fw-bold text-uppercase py-3"
                               style="background-color: #ff6600; color: white; border-radius: 15px; font-size: 0.9rem;">
                                Unirme al canal
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
    <footer class="footer-custom py-5">
        <div class="container">
            <div class="row align-items-start">
                <div class="col-md-5 mb-4">
                    <div class="footer-logo mb-4">
                        <img src="~/images/logo_erco_para_web-13.png" alt="ERCO" style="height: 60px;">
                    </div>

                    <h3 class="footer-title">Contacto</h3>
                    <ul class="list-unstyled contact-list">
                        <li><a href="https://www.google.com/maps/place/Erco+S.r.l./@@-34.5714508,-59.0936119,21z/data=!4m6!3m5!1s0x95bc877a91acb36d:0x8677d54c242137ba!8m2!3d-34.5714122!4d-59.0935933!16s%2Fg%2F11j4swg6q_?entry=tts&g_ep=EgoyMDI2MDQyMC4wIPu8ASoASAFQAw%3D%3D&skid=a3a68166-bb8d-4e04-afc3-4886de5c031b"><i class="bi bi-geo-alt"></i> Leiva 939, Luján</a></li>
                        <li><a href="https://api.whatsapp.com/send/?phone=5492323301623&text=Hola%21+Te+escribo+desde+la+web%21"><i class="bi bi-whatsapp"></i> Escribinos por WhatsApp</a></li>
                        <li>

                            <a class="link-email" asp-controller="Consultas" asp-action="Index">

                                <i class="bi bi-envelope"></i> distribuidoracali@ercosrl.com.ar

                            </a>

                        </li>
                        <li><a href="https://www.instagram.com/ercodistribuidoramayorista"><i class="bi bi-instagram"></i> Instagram</a></li>
                        <li><a href="https://www.facebook.com/ercosrl"><i class="bi bi-facebook"></i> Escribinos por Facebook</a></li>
                    </ul>
                </div>

                <div class="col-md-5 mb-4">
                    <h3 class="footer-title">Novedades</h3>
                    <p>Suscribite para recibir nuestras ofertas mayoristas.</p>
                    <form asp-controller="Suscripciones" asp-action="Suscribir" method="post">
                        <div class="mb-3">
                            <input type="text" class="form-control footer-input" placeholder="Tu nombre" required>
                        </div>
                        <div class="mb-3">
                            <input type="email" class="form-control footer-input" placeholder="Tu email" required>
                        </div>
                        <button class="btn btn-subscribe-gradient w-100" type="submit">Suscribirse</button>
                    </form>
                </div>

                <div class="col-md-2 mb-4 d-flex align-items-end justify-content-md-end">
                    <p class="mb-0 text-muted">© 2026 - ERCO</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/aos-master/aos-master/dist/aos.js"></script>
    <script src="~/lib/dist/leaflet.js"></script>
    <script>
        AOS.init();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
